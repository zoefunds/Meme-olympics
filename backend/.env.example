# Server
PORT=8080
NODE_ENV=production

# Postgres (Docker locally / Fly Postgres in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meme_olympics

# Upstash Redis (usage kept minimal — rate limits + short caches only)
REDIS_URL=

# Auth
JWT_SECRET=change-me-64-random-chars
JWT_EXPIRES_IN=7d
# 32-byte hex (64 chars): openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:8080

# GenLayer (fill after deploying contracts/meme_olympics.py via GenLayer Studio)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0xf363797335d66E6Af00502f43EDE872C5Fe19bCb
GENLAYER_OPERATOR_PRIVATE_KEY=

# Comma-separated wallet addresses auto-promoted to admin on first wallet
# login. Identity is wallet-only (Connect Wallet + sign-in message) — there
# is no email/password anywhere in this app.
ADMIN_WALLETS=

# Base Sepolia payment layer (contracts/base/MemeOlympicsEscrow.sol).
# GenLayer only judges; real USDC prize money is escrowed and claimed here.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
MEME_OLYMPICS_ESCROW_ADDRESS=
# Backend wallet authorized as the escrow's relayer (calls setWinners after
# a GenLayer competition finalizes). NEVER commit a real key here or paste
# one in chat/logs — set it directly in your deploy platform's secret store.
BASE_SEPOLIA_RELAYER_PRIVATE_KEY=
