# Server
PORT=8080
NODE_ENV=production

# Postgres (Docker locally / Fly Postgres in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meme_olympics

# Upstash Redis (usage kept minimal — rate limits + short caches only)
REDIS_URL=

# Auth
JWT_SECRET=change-me-64-random-chars
JWT_EXPIRES_IN=7d
# 32-byte hex (64 chars): openssl rand -hex 32
WALLET_ENCRYPTION_KEY=

# Frontend
FRONTEND_URL=http://localhost:3000

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Meme Olympics

# GenLayer (fill after Studio deployment — Phase 11)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=
GENLAYER_OPERATOR_PRIVATE_KEY=

# Comma-separated emails auto-promoted to admin on registration
ADMIN_EMAILS=preciousmofeoluwa@gmail.com
