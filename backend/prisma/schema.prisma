generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  // The user's connected wallet (MetaMask etc.) — sole identity, and the
  // sole signer for everything: login (SIWE), GenLayer writes (see
  // frontend/src/lib/genlayer.ts — genlayer-js signs via the injected
  // provider when given just an address), and Base Sepolia. No email, no
  // password, no separate custodial key anywhere in this app.
  authAddress         String       @unique
  username            String?      @unique
  role                String       @default("user") // user | admin
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  submissions         Submission[]
  disputes            Dispute[]
}

model Competition {
  id              String       @id // e.g. week-2026-28 (matches on-chain id)
  title           String
  theme           String
  status          String       @default("created") // created|open|judging|finalized|cancelled
  startsAt        DateTime
  endsAt          DateTime
  onchainCreated  Boolean      @default(false)
  onchainFinalized Boolean     @default(false)
  winnersJson     String       @default("[]")
  createdByUserId String?
  prizeAtto       String       @default("0") // declared USDC, 6-decimal base units (mirrors on-chain prize_pool_usdc; column name kept from the legacy GEN-atto design)
  // Base Sepolia tx hash once winners were pushed to the escrow contract —
  // "" means still pending relay. Mirrors GenLayer's own relay_tx_hash so
  // rewards.ts can tell "not yet relayed" apart from "relayed and fully
  // claimed" without an extra on-chain read per request.
  relayTxHash     String       @default("")
  createdAt       DateTime     @default(now())
  submissions     Submission[]

  @@index([status])
}

model Submission {
  id                   String      @id @default(cuid())
  competitionId        String
  userId               String
  title                String
  caption              String      @default("")
  imageUrl             String
  contextUrl           String      @default("")
  tagsJson             String      @default("[]")
  status               String      @default("pending") // pending|onchain|evaluated|disqualified|winner|failed
  onchainTxHash        String      @default("")
  totalScore           Int         @default(0)
  criteriaJson         String      @default("{}")
  plagiarismVerdict    String      @default("")
  plagiarismConfidence Int         @default(0)
  evaluationSummary    String      @default("")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  competition          Competition @relation(fields: [competitionId], references: [id])
  user                 User        @relation(fields: [userId], references: [id])
  disputes             Dispute[]

  @@index([competitionId, status])
  @@index([userId])
}

model Dispute {
  id             String     @id @default(cuid())
  submissionId   String
  userId         String
  reason         String
  evidenceUrl    String
  status         String     @default("open") // open|upheld|rejected
  verdict        String     @default("")
  onchainOpened  Boolean    @default(false) // true only once open_dispute is confirmed on-chain
  createdAt      DateTime   @default(now())
  resolvedAt     DateTime?
  submission   Submission @relation(fields: [submissionId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([submissionId])
}

model Image {
  id        String   @id @default(cuid())
  userId    String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}
